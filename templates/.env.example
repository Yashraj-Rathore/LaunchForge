# Local example only. Copy to a local untracked .env file.
# Never commit real credentials.

POSTGRES_DB=launchforge
POSTGRES_USER=launchforge
POSTGRES_PASSWORD=replace-local-only

# Management / OIDC - values finalized in M1
OIDC_ISSUER_URI=http://localhost:8081/realms/launchforge
OIDC_CLIENT_ID=launchforge-management
OIDC_CLIENT_SECRET=replace-local-only

# Runtime dependencies introduced later
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_URL=redis://localhost:6379
CLICKHOUSE_URL=http://localhost:8123

# Never use these sample values outside local fictional demo.
DEMO_SEED_ENABLED=false
