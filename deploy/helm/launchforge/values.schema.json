{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "revision",
        "databaseSchemaVersion",
        "snapshotSchemaVersions",
        "evaluationAlgorithmVersions"
      ],
      "properties": {
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "revision": {
          "type": "string",
          "pattern": "^(unknown|[0-9a-f]{40})$"
        },
        "databaseSchemaVersion": { "type": "integer", "minimum": 0 },
        "snapshotSchemaVersions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "evaluationAlgorithmVersions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["management", "configEdge", "eventWorker", "web", "migrator"],
      "properties": {
        "management": { "$ref": "#/definitions/image" },
        "configEdge": { "$ref": "#/definitions/image" },
        "eventWorker": { "$ref": "#/definitions/image" },
        "web": { "$ref": "#/definitions/image" },
        "migrator": { "$ref": "#/definitions/image" }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[0-9a-f]{64})$"
        },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    }
  }
}
