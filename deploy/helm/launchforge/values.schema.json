{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "revision",
        "databaseSchemaVersion",
        "snapshotSchemaVersions",
        "evaluationAlgorithmVersions"
      ],
      "properties": {
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "revision": {
          "type": "string",
          "pattern": "^(unknown|[0-9a-f]{40})$"
        },
        "databaseSchemaVersion": { "type": "integer", "minimum": 0 },
        "snapshotSchemaVersions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "evaluationAlgorithmVersions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["management", "configEdge", "eventWorker", "web", "migrator"],
      "properties": {
        "management": { "$ref": "#/definitions/image" },
        "configEdge": { "$ref": "#/definitions/image" },
        "eventWorker": { "$ref": "#/definitions/image" },
        "web": { "$ref": "#/definitions/image" },
        "migrator": { "$ref": "#/definitions/image" }
      }
    },
    "external": {
      "type": "object",
      "required": ["kafka", "redis"],
      "properties": {
        "kafka": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bootstrapServers",
            "configTopic",
            "securityProtocol",
            "saslMechanism",
            "saslLoginModule"
          ],
          "properties": {
            "bootstrapServers": { "type": "string", "minLength": 1 },
            "configTopic": { "type": "string", "minLength": 1 },
            "securityProtocol": {
              "enum": ["PLAINTEXT", "SSL", "SASL_PLAINTEXT", "SASL_SSL"]
            },
            "saslMechanism": { "type": "string", "minLength": 1, "maxLength": 64 },
            "saslLoginModule": {
              "type": "string",
              "pattern": "^[A-Za-z_$][A-Za-z0-9_$.]+$",
              "maxLength": 256
            }
          }
        },
        "redis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "port", "tls", "usernames", "materializationSigningKeyId"],
          "properties": {
            "host": { "type": "string", "minLength": 1 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "properties": { "enabled": { "type": "boolean" } }
            },
            "usernames": {
              "type": "object",
              "additionalProperties": false,
              "required": ["management", "configEdge", "eventWorker"],
              "properties": {
                "management": { "type": "string", "minLength": 1 },
                "configEdge": { "type": "string", "minLength": 1 },
                "eventWorker": { "type": "string", "minLength": 1 }
              }
            },
            "materializationSigningKeyId": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "required": [
        "existingSecret",
        "redisTlsTrustCertificateKey",
        "kafkaSaslUsernameKey",
        "kafkaSaslPasswordKey",
        "kafkaTlsTrustCertificateKey"
      ],
      "properties": {
        "existingSecret": { "$ref": "#/definitions/secretKey" },
        "redisTlsTrustCertificateKey": { "$ref": "#/definitions/secretKey" },
        "kafkaSaslUsernameKey": { "$ref": "#/definitions/secretKey" },
        "kafkaSaslPasswordKey": { "$ref": "#/definitions/secretKey" },
        "kafkaTlsTrustCertificateKey": { "$ref": "#/definitions/secretKey" }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[0-9a-f]{64})$"
        },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "secretKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$",
      "minLength": 1,
      "maxLength": 253
    }
  }
}
