# syntax=docker/dockerfile:1.7
ARG NODE_IMAGE=node:24.19.0-bookworm-slim@sha256:3638d9a6fe4030bd716be989438248074489337ba3275657f93595428be4fc03
ARG NGINX_IMAGE=nginx:1.31.2-alpine3.23@sha256:54f2a904c251d5a34adf545a72d32515a15e08418dae0266e23be2e18c66fefa

FROM ${NODE_IMAGE} AS build
ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@11.21.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY frontend/admin-web/package.json frontend/admin-web/package.json
COPY demos/react-storefront/package.json demos/react-storefront/package.json
COPY sdks/javascript/packages/browser/package.json sdks/javascript/packages/browser/package.json
COPY sdks/javascript/packages/core/package.json sdks/javascript/packages/core/package.json
COPY sdks/javascript/packages/react/package.json sdks/javascript/packages/react/package.json
COPY tests/e2e/package.json tests/e2e/package.json
RUN pnpm install --frozen-lockfile
COPY frontend/admin-web/ frontend/admin-web/
RUN pnpm --filter @launchforge/admin-web build

FROM build AS validation
COPY .github/ .github/
COPY .prettierignore .prettierrc.json compose.yaml ./
COPY contracts/golden-vectors/ contracts/golden-vectors/
COPY deploy/helm/launchforge/ deploy/helm/launchforge/
COPY deploy/release/ deploy/release/
COPY security/ security/
COPY sdks/javascript/ sdks/javascript/
COPY demos/react-storefront/ demos/react-storefront/
COPY tests/e2e/ tests/e2e/
RUN pnpm format:check
RUN pnpm lint
RUN pnpm typecheck
RUN pnpm test
RUN pnpm build

FROM build AS demo-build
ARG DEMO_EDGE_URL=http://127.0.0.1:8082
ARG DEMO_CLIENT_KEY_SUFFIX=NorthstarDemoClientKey0000000001
ENV VITE_LAUNCHFORGE_EDGE_URL=${DEMO_EDGE_URL}
ENV VITE_LAUNCHFORGE_CLIENT_KEY=lf_client_${DEMO_CLIENT_KEY_SUFFIX}
COPY sdks/javascript/ sdks/javascript/
COPY demos/react-storefront/ demos/react-storefront/
RUN pnpm --filter @launchforge/js-core build \
    && pnpm --filter @launchforge/js-browser build \
    && pnpm --filter @launchforge/react-sdk build \
    && pnpm --filter @launchforge/react-storefront-demo build

FROM ${NGINX_IMAGE} AS demo-runtime
ARG OCI_CREATED=unknown
ARG OCI_REVISION=unknown
ARG OCI_VERSION=dev
LABEL org.opencontainers.image.title="Northstar Commerce LaunchForge demo" \
      org.opencontainers.image.description="Fictional React storefront using the LaunchForge browser SDK" \
      org.opencontainers.image.source="https://github.com/Yashraj-Rathore/LaunchForge" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.revision="${OCI_REVISION}" \
      org.opencontainers.image.version="${OCI_VERSION}" \
      org.opencontainers.image.licenses="Apache-2.0"
RUN apk upgrade --no-cache \
    && rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/default.conf \
    && mkdir -p /var/cache/nginx /var/run/nginx \
    && chown -R 101:101 /var/cache/nginx /var/run/nginx /etc/nginx/conf.d
COPY --from=demo-build --chown=101:101 /workspace/demos/react-storefront/dist/ /usr/share/nginx/html/
COPY --chown=101:101 deploy/docker/nginx.conf /etc/nginx/nginx.conf
COPY --chown=101:101 deploy/docker/demo.conf /etc/nginx/conf.d/demo.conf
EXPOSE 8080
USER 101:101
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=6 \
  CMD wget --quiet --spider http://127.0.0.1:8080/healthz || exit 1
ENTRYPOINT ["nginx", "-g", "daemon off;"]

FROM ${NGINX_IMAGE} AS runtime
ARG OCI_CREATED=unknown
ARG OCI_REVISION=unknown
ARG OCI_VERSION=dev
LABEL org.opencontainers.image.title="LaunchForge admin web" \
      org.opencontainers.image.description="LaunchForge same-origin administration console" \
      org.opencontainers.image.source="https://github.com/Yashraj-Rathore/LaunchForge" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.revision="${OCI_REVISION}" \
      org.opencontainers.image.version="${OCI_VERSION}" \
      org.opencontainers.image.licenses="Apache-2.0"
RUN apk upgrade --no-cache \
    && rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/default.conf \
    && mkdir -p /var/cache/nginx /var/run/nginx \
    && chown -R 101:101 /var/cache/nginx /var/run/nginx /etc/nginx/conf.d
COPY --from=build --chown=101:101 /workspace/frontend/admin-web/dist/ /usr/share/nginx/html/
COPY --chown=101:101 deploy/docker/nginx.conf /etc/nginx/nginx.conf
COPY --chown=101:101 deploy/docker/launchforge.conf /etc/nginx/conf.d/launchforge.conf
EXPOSE 8080
USER 101:101
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=6 \
  CMD wget --quiet --spider http://127.0.0.1:8080/healthz || exit 1
ENTRYPOINT ["nginx", "-g", "daemon off;"]
