# Local development only. Copy to .env and replace the password before starting Compose.
LAUNCHFORGE_POSTGRES_DB=launchforge
LAUNCHFORGE_POSTGRES_USER=launchforge
LAUNCHFORGE_POSTGRES_PASSWORD=replace-with-a-local-only-password
LAUNCHFORGE_POSTGRES_PORT=55432
# Loopback is the safe default. The kind proof temporarily sets 0.0.0.0 so its node can
# reach the external Compose dependencies through host.docker.internal.
LAUNCHFORGE_BIND_ADDRESS=127.0.0.1

# Export these three values before starting the Control API locally.
LAUNCHFORGE_DB_URL=jdbc:postgresql://localhost:55432/launchforge
LAUNCHFORGE_DB_USER=launchforge
LAUNCHFORGE_DB_PASSWORD=replace-with-the-same-local-only-password

# Local Keycloak reference. Never reuse these local-only passwords elsewhere.
LAUNCHFORGE_KEYCLOAK_ADMIN_USERNAME=local-admin
LAUNCHFORGE_KEYCLOAK_ADMIN_PASSWORD=replace-with-a-local-only-admin-password
LAUNCHFORGE_DEMO_USER_PASSWORD=replace-with-a-local-only-demo-password

# Export these values before starting the Control API with the local profile.
LAUNCHFORGE_OIDC_ISSUER_URI=http://localhost:8081/realms/launchforge
LAUNCHFORGE_OIDC_CLIENT_ID=launchforge-control
LAUNCHFORGE_DEMO_SEED_ENABLED=true
LAUNCHFORGE_DEMO_SEED_LOCATION=file:deploy/local/tenancy-seed.sql
LAUNCHFORGE_SESSION_ABSOLUTE_LIFETIME=12h

# Generate one shared, random local value of at least 32 bytes. Control API and Config Edge
# must receive the same value; it is an HMAC pepper and must never be committed when set.
LAUNCHFORGE_SDK_KEY_PEPPER=replace-with-at-least-32-random-bytes
LAUNCHFORGE_SDK_KEY_PEPPER_VERSION=v1
LAUNCHFORGE_CONFIG_EDGE_PORT=8082
LAUNCHFORGE_EVENT_WORKER_PORT=8083
LAUNCHFORGE_WEB_PORT=8080
LAUNCHFORGE_DEMO_STOREFRONT_PORT=5174
LAUNCHFORGE_IMAGE_TAG=local
# Containers and kind use this host-reachable local origin. It is not a production issuer.
LAUNCHFORGE_CONTAINER_OIDC_ORIGIN=http://host.docker.internal:8081
LAUNCHFORGE_CONTAINER_OIDC_ISSUER_URI=http://host.docker.internal:8081/realms/launchforge

# M7 distribution services (`docker compose --profile distribution up -d --wait`).
LAUNCHFORGE_KAFKA_PORT=59092
LAUNCHFORGE_KAFKA_ADVERTISED_HOST=localhost
LAUNCHFORGE_KAFKA_BOOTSTRAP_SERVERS=localhost:59092
LAUNCHFORGE_KAFKA_CONFIG_TOPIC=launchforge.config.revision-published.v1
LAUNCHFORGE_KAFKA_CONSUMER_GROUP=launchforge-config-projector-v1
LAUNCHFORGE_REDIS_HOST=localhost
LAUNCHFORGE_REDIS_PORT=56379
LAUNCHFORGE_REDIS_INVALIDATION_CHANNEL=launchforge:config:revision-hints:v1

# M8 optional analytics (`docker compose --profile distribution --profile analytics up -d --wait`).
# Analytics remains disabled in every process until LAUNCHFORGE_ANALYTICS_ENABLED=true is exported.
LAUNCHFORGE_ANALYTICS_ENABLED=false
LAUNCHFORGE_KAFKA_ANALYTICS_TOPIC=launchforge.analytics.evaluations.v1
LAUNCHFORGE_KAFKA_ANALYTICS_CONSUMER_GROUP=launchforge-analytics-writer-v1
LAUNCHFORGE_CLICKHOUSE_PORT=58123
LAUNCHFORGE_CLICKHOUSE_URL=http://localhost:58123
LAUNCHFORGE_CLICKHOUSE_USER=launchforge
LAUNCHFORGE_CLICKHOUSE_PASSWORD=replace-with-a-local-only-clickhouse-password

# M10 observability (docker compose --profile observability up -d --wait).
LAUNCHFORGE_OTEL_ENABLED=false
LAUNCHFORGE_OTLP_METRICS_ENABLED=false
LAUNCHFORGE_OTLP_GRPC_PORT=4317
LAUNCHFORGE_OTLP_HTTP_PORT=4318
LAUNCHFORGE_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
LAUNCHFORGE_TRACE_SAMPLING_PROBABILITY=0.1
LAUNCHFORGE_DEPLOYMENT_ENVIRONMENT=local
LAUNCHFORGE_LOG_FORMAT=ecs
LAUNCHFORGE_PROMETHEUS_PORT=59090
LAUNCHFORGE_GRAFANA_PORT=53000
LAUNCHFORGE_GRAFANA_ADMIN_USER=launchforge
LAUNCHFORGE_GRAFANA_ADMIN_PASSWORD=replace-with-a-local-only-grafana-password
