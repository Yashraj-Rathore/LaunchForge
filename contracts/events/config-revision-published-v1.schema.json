{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchforge.dev/contracts/events/config-revision-published-v1.schema.json",
  "title": "Config revision published event v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "organizationId",
    "projectId",
    "environmentId",
    "revision",
    "snapshotChecksum",
    "traceId"
  ],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "config.revision-published.v1" },
    "schemaVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "organizationId": { "type": "string", "format": "uuid" },
    "projectId": { "type": "string", "format": "uuid" },
    "environmentId": { "type": "string", "format": "uuid" },
    "revision": { "type": "integer", "minimum": 1 },
    "snapshotChecksum": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "traceId": { "type": "string", "minLength": 1, "maxLength": 128 }
  }
}
