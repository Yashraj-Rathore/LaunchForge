{
  "name": "@launchforge/react-storefront-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests --exclude=e2e/**",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@launchforge/js-browser": "workspace:*",
    "@launchforge/js-core": "workspace:*",
    "@launchforge/react-sdk": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
